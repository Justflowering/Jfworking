{
  "name": "seomu-dowoomi",
  "version": "1.0.0",
  "description": "지방공무원 서무도우미",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.seomu.app",
    "productName": "서무도우미",
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
    {
      "provider": "github",
      "owner": "justflowering",
      "repo": "Jfworking"
    }
    ]
  },
  "author": "Seomu",
  "license": "ISC",
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^31.0.1",
    "electron-builder": "^26.8.1"
  }
}
